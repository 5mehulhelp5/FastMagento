<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework/Event/etc/events.xsd">
    <event name="sales_quote_collect_totals_before">
        <observer name="fastmagento_apply_catalog_rule_price" instance="ParkkTech\FastMagento\Observer\ApplyCatalogRulePrice" />
    </event>

    <!--
        Applies the search-page takeover (removing native results + layered nav) only when the
        instant search grid is actually enabled AND its block is present. Previously these
        removals lived unconditionally in catalogsearch_result_index.xml, which stripped native
        results even when the replacement could not render — producing a blank results page.
    -->
    <event name="layout_generate_blocks_after">
        <observer name="fastmagento_apply_instant_search_layout" instance="ParkkTech\FastMagento\Observer\ApplyInstantSearchLayout" />
        <!-- Menu rendered inline (no ESI round-trip under Varnish) and Hyvä's section data
             block-cached per store. See the observer for why each is safe. -->
        <observer name="fastmagento_inline_menu_section_data" instance="ParkkTech\FastMagento\Observer\InlineMenuAndSectionData" />
    </event>

</config>
