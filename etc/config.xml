<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <fastmagento>
            <indexing>
                <opensearch_index_prefix>products</opensearch_index_prefix>
                <opensearch_category_index_prefix>categories</opensearch_category_index_prefix>
                <!-- Instant product update. Default ON: a MANUAL SINGLE-PRODUCT ADMIN EDIT
                     (catalog_product_save) immediately reprojects that product (+ composite
                     parents) into OpenSearch and purges its full-page cache, bypassing the
                     scheduled indexer + FPC lag so staff see edits live. Scope is enforced in
                     Observer\InstantUpdateOnSave: API (REST/GraphQL) writes, admin bulk actions
                     (mass status/delete, Update Attributes), imports and cron all fall through to
                     the normal scheduled mview indexer, so a mass save never fans out into N
                     reprojections. -->
                <instant_product_update>1</instant_product_update>
                <!-- When instant update purges the cache, also purge the product's category pages
                     (not just its own page). Default ON. -->
                <instant_purge_categories>1</instant_purge_categories>
                <!-- Max mapped fields per FastMagento OpenSearch index, applied at index-CREATE
                     time (see Model\OpenSearch\IndexSettings). The product index maps attributes
                     under a dynamic object, so an attribute-heavy catalog blows past OpenSearch's
                     default 1000 — and a per-item bulk rejection does NOT fail the request, so
                     documents used to go missing while the reindex reported success. Raise this if
                     a reindex reports "Limit of total fields ... exceeded", then reindex. -->
                <os_total_fields_limit>5000</os_total_fields_limit>
            </indexing>
            <serving>
                <!-- Serve the product page's stock badge from the indexed is_in_stock instead of
                     querying cataloginventory_stock_status. Default ON. Display only: order
                     placement re-checks stock by SKU, so a briefly stale index can show a stale
                     badge but cannot let an oversell through. -->
                <serve_stock_status>1</serve_stock_status>
                <!-- Answer category child/descendant lookups from the indexed category tree
                     instead of catalog_category_entity. Default ON. The tree is loaded once per
                     request by CategoryDataProvider, so these become in-memory reads. Falls back
                     to the database whenever the category is not indexed or the tree is
                     unavailable. -->
                <serve_category_tree>1</serve_category_tree>
            </serving>
            <plp>
                <!--
                    Serve the category/search product LISTING from OpenSearch instead of EAV.
                    Default ON: serving the catalogue from the index is what this module is for,
                    and this is the page type where EAV hydration costs the most.
                    Failsafe by construction — a page is served from the index only when EVERY
                    product on it is present there; any miss, or any OpenSearch error, falls the
                    whole page back to the native EAV load rather than rendering partial data.
                    Set to 0 to force the native path; `bin/magento fastmagento:doctor` reports
                    which path is live.
                -->
                <serve_listing>1</serve_listing>
                <!-- Take the page's product ids from the search engine's own answer, already
                     present in the collection's SELECT, instead of running that SELECT against
                     MySQL purely to re-derive it. Default ON. Strictly guarded: it only applies
                     when the select provably does nothing but restrict to a known id list in a
                     known order, and falls back to the query for any sort or filter it cannot
                     reproduce (price sorting, layered-nav price/stock filters, ...). -->
                <serve_page_ids>1</serve_page_ids>
                <!-- Diagnostic. Computes the ids BOTH ways and logs any disagreement, serving the
                     SQL answer when they differ. Off by default because it performs the very
                     query the setting above exists to avoid. Turn it on to validate a store's
                     own sorts and filters, then turn it back off. -->
                <page_id_parity_check>0</page_id_parity_check>
            </plp>
            <search>
                <!-- Attribute facets on the instant search results page (comma-separated codes).
                     EMPTY NOW MEANS AUTO-DETECT, not "none": RelevanceConfig::getFacetAttributes()
                     derives the list from every select/multiselect attribute flagged
                     is_filterable_in_search, which is exactly the set Magento's native index makes
                     aggregatable. Blank previously meant no attribute facets at all, so a store
                     that never found this setting had none and nothing said why.
                     Multi-select and configurable-parent (multi-value) documents are handled:
                     option labels resolve from the fastmagento_attribute_option dictionary
                     (Model\OptionDictionary), so an id no longer has to be pairable with a label
                     from a single hit. Set explicit codes here to override auto-detect. -->
                <facet_attributes/>
                <!-- Master switch for the search-page takeover: 1 = the OpenSearch instant grid
                     replaces native search results, 0 = native Magento search (the safe fallback
                     on a theme whose JS layer we do not support). See
                     Observer\ApplyInstantSearchLayout. -->
                <instant_search_enabled>1</instant_search_enabled>
                <!-- Product columns per row on the search results grid. Set to match the theme's
                     category-listing column count so search and category pages look consistent.
                     Reduced automatically on tablet/mobile. Default 4. -->
                <grid_columns>4</grid_columns>
                <typo_tolerance>1</typo_tolerance>
                <boost_in_stock>1</boost_in_stock>
                <custom_ranking_direction>desc</custom_ranking_direction>
                <!-- How multiple query terms combine: any (OR, minimum_should_match:1 — today's
                     behaviour), all (AND — every term must match), most (minimum_should_match:75%).
                     Default any to preserve behaviour; switch to all/most to tighten precision. -->
                <search_operator>any</search_operator>
                <!-- Exact/phrase match boost: a product whose name/keywords contain the query as a
                     contiguous phrase outranks scattered-token hits. 0 disables. -->
                <phrase_match_boost>4</phrase_match_boost>
                <!-- AI keyword layer (fm_search_keywords). Populated OFF the request path by
                     bin/magento fastmagento:search-keywords:generate. Default OFF: no commit
                     changes live search until a store enables it AND runs the generator. -->
                <search_keywords_enabled>0</search_keywords_enabled>
                <search_keywords_weight>8</search_keywords_weight>
                <!-- Attribute codes whose labels give the AI product context when generating
                     keywords. Blank falls back to the facet attributes above. -->
                <keyword_source_attributes/>
                <stopwords>a, an, and, or, the, of, for, with, to, in, on, at, by, is, it, this, that, your, my</stopwords>
                <!-- Global synonym groups. Keep terms DISTINCTIVE: a group term that is a common
                     catalogue word (e.g. "side" inside "side by side") over-broadens every query
                     that expands to it, because synonym equivalents are matched at full strength.
                     Put buyer PHRASES that contain common words (e.g. "side by side" -> UTV) in the
                     per-product AI keyword layer (fm_search_keywords) instead, where they match
                     precisely. That's why "sxs, utv" lives here but "side by side" does not. -->
                <!--
                    Intentionally EMPTY. Synonyms are store vocabulary: shipping one store's
                    terms as a global default silently expands every other store's queries.
                    Starter packs live in etc/synonym-packs/ — import with
                    `bin/magento fastmagento:synonyms:import <pack>` or paste your own here.
                -->
                <synonyms/>
            </search>
            <ai>
                <claude_model>claude-opus-4-8</claude_model>
                <max_terms>1200</max_terms>
            </ai>
            <!-- Admin attribute-option pagination. Default ON: replaces Magento's native
                 "Manage Options"/swatch grid (which loads and re-saves the WHOLE option set and
                 crashes past a few thousand options) with a paginated, per-row-CRUD manager. -->
            <attribute_pagination>
                <enabled>1</enabled>
                <page_size>50</page_size>
            </attribute_pagination>
            <cache>
                <!-- Re-prime FastMagento's option dictionary right after a cache flush rather than
                     on the next shopper request. Default ON: the rebuild happens either way, and
                     doing it in the flushing process costs an operator a moment instead of costing
                     a customer a slow page. Set to 0 when scripting many flushes back to back. -->
                <warm_after_flush>1</warm_after_flush>
                <!-- Comma-separated paths to request after a flush. Empty = each store's home
                     page. A category page is the highest-value entry after home: the EAV and
                     block caches it builds are the ones every other category page reuses. -->
                <warm_paths/>
            </cache>
            <efficiency>
                <!-- Extension-efficiency monitor. Scheduled scan is OFF by default: the scan
                     briefly enables db_logger to attribute SQL to modules, so a store opts in
                     explicitly (or runs it on demand from the admin page / CLI). -->
                <cron_enabled>0</cron_enabled>
                <cron_expr>0 3 * * 0</cron_expr>
                <sample_size>50</sample_size>
            </efficiency>
            <cart>
                <!-- Master toggle. Default ON. Turning it on enables the WHOLE fast pipeline —
                     OS-serving the quote items, optimistic stock, AND fast stock sync — so Fast
                     Checkout works fully out of the box. Safe by default: any product
                     missing/partial in the index falls back to the native path, and order
                     placement still gates stock by SKU (cannot oversell). Set to 0 to disable the
                     whole bundle. The individual (advanced) toggles below stay 0 by design: the
                     master implies them, and each can still force its feature on by itself when
                     the master is off (that OR is why they must default 0 — otherwise turning the
                     master off would not disable them). -->
                <enable_fast_checkout>1</enable_fast_checkout>
                <!-- Advanced override (default 0). Implied ON by the master above. OS-serves the
                     quote-item collection (checkout code). Set 1 to force on while the master is off. -->
                <os_serve_quote_items>0</os_serve_quote_items>
                <!-- Advanced override (default 0). Implied ON by the master above. Optimistic
                     stock — skip the redundant per-load MSI stock preload and rely on the
                     placement-time CheckItemsQuantity gate. Set 1 to force on while master is off. -->
                <optimistic_stock>0</optimistic_stock>
                <!-- Advanced override (default 0). Implied ON by the master above. Fast stock
                     sync — when an order/refund/inventory save mutates stock, patch just the stock
                     fields of the affected OpenSearch docs (mget patch is_in_stock/qty +
                     composite child stock bulk re-index) instead of a full EAV reprojection.
                     Falls back to a full reproject for any doc missing/partial in the index.
                     Background (post-response) work. Set 1 to force on while the master is off. -->
                <fast_stock_sync>0</fast_stock_sync>
                <!-- Line-item name for configurable products on cart/mini-cart/checkout:
                     parent = the configurable name (Magento default), child = the purchased
                     simple's name. Default parent = no change. -->
                <configurable_line_name>parent</configurable_line_name>
            </cart>
            <!-- Subtle "Powered by FastMagento" footer credit. Default on; a real visible
                 attribution link (not hidden/cloaked). Stores can switch it off here. -->
            <credit>
                <show>1</show>
            </credit>
            <!-- GraphQL Serving. Default ON. os_serve_products hydrates storefront
                 products()/category-products() GraphQL reads from OpenSearch (same result set as
                 native, just faster - see Plugin\GraphQl\ProductCollectionOsHydrationPlugin +
                 etc/graphql/di.xml). os_serve_search routes GraphQL fulltext search through
                 FastMagento's OpenSearch relevance engine, consistent with the storefront and
                 tuned via the Instant Search & Relevance settings. Hard native fallback for any
                 missing/partial doc, unmapped sort/filter/aggregation, or error, so it never
                 breaks a query. -->
            <graphql>
                <os_serve_products>1</os_serve_products>
                <os_serve_search>1</os_serve_search>
            </graphql>
        </fastmagento>
    </default>
</config>
