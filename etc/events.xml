<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework/Event/etc/events.xsd">

<!--    <event name="catalog_product_save_after">-->
<!--        <observer name="fastmagento_product_save" instance="ParkkTech\FastMagento\Observer\ProductSave" />-->
<!--    </event>-->

    <!-- Real-time OpenSearch stock sync: reproject affected products (+ parents) on order
         placement and refund/return so qty + in-stock status stay live. -->
    <event name="sales_order_place_after">
        <observer name="fastmagento_reindex_on_order_place"
                  instance="ParkkTech\FastMagento\Observer\ReindexOnOrderPlace"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="fastmagento_reindex_on_creditmemo"
                  instance="ParkkTech\FastMagento\Observer\ReindexOnCreditmemo"/>
    </event>
    <!-- Instant product update: once a product save COMMITS, reproject it into OpenSearch and purge
         its full-page cache right away (bypassing the scheduled indexer + FPC lag) so staff see
         catalogue edits live. Commit-after (not save-after) so a rolled-back save never leaves the
         index/cache ahead of the DB. Gated by fastmagento/indexing/instant_product_update (off by default). -->
    <event name="catalog_product_save_commit_after">
        <observer name="fastmagento_instant_update_on_save"
                  instance="ParkkTech\FastMagento\Observer\InstantUpdateOnSave"/>
    </event>
    <!-- Remove deleted products from the OpenSearch serving index. -->
    <event name="catalog_product_delete_after">
        <observer name="fastmagento_remove_on_product_delete"
                  instance="ParkkTech\FastMagento\Observer\RemoveOnProductDelete"/>
    </event>
</config>
