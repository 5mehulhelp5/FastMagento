<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Mview/etc/mview.xsd">

    <!--
        The "id" must match the indexer ID from indexer.xml.
        We omit a standalone <field> node because Magento 2.4.x only allows <subscriptions> here.
    -->
    <view
        id="fastmagento_product_indexer"
        class="ParkkTech\FastMagento\Model\Indexer\ProductIndexer"
        group="indexer">


        <subscriptions>
            <!--
                'field="entity_id"' indicates the primary key field to track changes by.
                When the "catalog_product_entity" table changes, we incrementally update the indexer.
            -->

            <table name="catalog_product_entity" entity_column="entity_id">
                <additionalColumns>
                    <column name="entity_id" cl_name="entity_id" />
                </additionalColumns>
            </table>
         <!--   <table name="catalog_product_entity" entity_column="entity_id" />-->

        </subscriptions>
    </view>

</config>
