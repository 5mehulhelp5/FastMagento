<?php
/** @var \ParkkTech\FastMagento\Block\Category\View $block */
$products = $block->getCategoryProducts();
?>

<div class="category-products">
    <h1><?= __('Category Products') ?></h1>

    <?php if (!empty($products)): ?>
        <div class="products-grid">
            <?php foreach ($products as $product): ?>
                <div class="product-item">
                    <a href="<?= $block->getUrl('catalog/product/view', ['id' => $product['id']]) ?>">
                        <img src="<?= $block->escapeUrl($product['image'] ?? 'default.jpg') ?>"
                             alt="<?= $block->escapeHtml($product['name']) ?>" />
                        <h2><?= $block->escapeHtml($product['name']) ?></h2>
                        <span class="price"><?= $block->escapeHtml($product['final_price']) ?></span>
                    </a>
                </div>
            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <p><?= __('No products found in this category.') ?></p>
    <?php endif; ?>
</div>
