<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <!-- Remove default product list that queries DB -->
    <body>
        <referenceBlock name="category.products.list" remove="true" />

        <!-- Insert your custom block to fetch from <prefix>_plp index (or the same _pdp index if you want) -->
        <referenceContainer name="content">
            <block class="ParkkTech\FastMagento\Block\Product\ListProduct"
                   name="fastmagento.product.list"
                   template="ParkkTech_FastMagento::product/list.phtml"/>
        </referenceContainer>
    </body>
</page>
